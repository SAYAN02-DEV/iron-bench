dummy_payload
/bases/
/microvms/

# Binaries and compiled outputs
bin/
*.exe
*.out
*.test
# Go workspace files
go.work
go.work.sum

# Dependencies and build outputs
node_modules/
.next/
out/
build/
.swc/
